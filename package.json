{
  "name": "maze-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "SceneryStack port of the PhET 'Maze Game' simulation. Drive a particle through tile-based mazes using position, velocity, or acceleration control modes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPhysics/MazeGame.git"
  },
  "keywords": [
    "maze-game",
    "simulation",
    "SceneryStack",
    "interactive",
    "physics",
    "kinematics",
    "vectors",
    "education",
    "pwa"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "fix": "biome check --write .",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:query-params": "node scripts/check-query-params.mjs",
    "icons": "tsx scripts/generate-icons.ts",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/ensure-rolldown-binding.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "scenerystack": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@rolldown/binding-linux-x64-gnu": "^1.0.2",
    "@types/node": "^25.9.2",
    "happy-dom": "^20.9.0",
    "playwright": "^1.52.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
